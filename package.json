{
  "name": "war-room",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Dashboard of merged PRs across the OpenAstro repos, with plain-English summaries.",
  "scripts": {
    "collect": "tsx src/collect.ts",
